# LiveKit Cloud or Self-Hosted Server Configuration
# Get these from your LiveKit Cloud Dashboard (https://cloud.livekit.io) or local livekit-server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxx
LIVEKIT_API_SECRET=sec_yyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Google OAuth credentials. Add http://localhost:3000/api/auth/callback/google
# as an authorized redirect URI in the Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTHORIZED_HOST_EMAIL=host@example.com

# Optional public URL for generating absolute invite links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: assign existing studios without an owner to this host
# LEGACY_DATA_OWNER_EMAIL=host@example.com
